      MeasureTheory.volume ∧
    MeasureTheory.Integrable
        (fun x =>
          GaussianComparison.GaussianModel.meanScaledDensity μ t x *
            inner ℝ (gradient g x) (GaussianComparison.GaussianModel.meanScaledPosterior μ t x))
        MeasureTheory.volume ∧
      ∫ (x : GaussianComparison.GaussianModel.Space d),
          deriv (fun s => GaussianComparison.GaussianModel.meanScaledDensity μ s x) t * g x =
        ∫ (x : GaussianComparison.GaussianModel.Space d),
          GaussianComparison.GaussianModel.meanScaledDensity μ t x *
            inner ℝ (gradient g x) (GaussianComparison.GaussianModel.meanScaledPosterior μ t x)
GaussianMixturePaper.lemma3_exponential (d : ℕ) (c : ℝ) :
  ∫ (x : GaussianComparison.GaussianModel.Space d), GaussianComparison.GaussianModel.phi x * Real.exp (c * ‖x‖) ≤
    2 ^ (↑d / 2) * Real.exp (c ^ 2)
GaussianMixturePaper.lemma3_polynomial (d : ℕ) (c : ℝ) (k : ℕ) :
  ∫ (x : GaussianComparison.GaussianModel.Space d),
      GaussianComparison.GaussianModel.phi x * (1 + ‖x‖) ^ k * Real.exp (c * ‖x‖) ≤
    2 ^ (↑k + ↑d / 2) * ↑k.factorial * Real.exp ((c + 1) ^ 2)
GaussianMixturePaper.lemma4.{u_1} {X : Type u_1} [MeasurableSpace X] {μ : MeasureTheory.Measure X} {I : Set ℝ}
  {H : ℝ → X → ℝ} (hI : IsOpen I) (hjoint : Measurable fun z => H (↑z.1) z.2)
  (hC1 : ∀ᵐ (x : X) ∂μ, ContDiffOn ℝ 1 (fun t => H t x) I)
  (hdom :
    ∀ (a b : ℝ),
      Set.Icc a b ⊆ I →
        ∃ P Q,
          Measurable P ∧
            Measurable Q ∧
              (∀ (x : X), 0 ≤ P x) ∧
                (∀ (x : X), 0 ≤ Q x) ∧
                  MeasureTheory.Integrable (fun x => P x + Q x) μ ∧
                    ∀ᵐ (x : X) ∂μ, ∀ t ∈ Set.Icc a b, ‖H t x‖ ≤ P x ∧ ‖deriv (fun s => H s x) t‖ ≤ Q x) :
  ContDiffOn ℝ 1 (fun t => ∫ (x : X), H t x ∂μ) I ∧
    ∀ t ∈ I,
      MeasureTheory.Integrable (H t) μ ∧
        MeasureTheory.Integrable (fun x => deriv (fun s => H s x) t) μ ∧
          HasDerivAt (fun s => ∫ (x : X), H s x ∂μ) (∫ (x : X), deriv (fun s => H s x) t ∂μ) t
GaussianMixturePaper.density_envelopes {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  {T t : ℝ} (hT : 0 ≤ T) (ht : |t| ≤ T) (x : GaussianComparison.GaussianModel.Space d) :
  GaussianComparison.GaussianModel.phi x * Real.exp (-T * M * ‖x‖ - T ^ 2 * M ^ 2 / 2) ≤
      GaussianComparison.GaussianModel.meanScaledDensity μ t x ∧
    GaussianComparison.GaussianModel.meanScaledDensity μ t x ≤
      GaussianComparison.GaussianModel.phi x * Real.exp (T * M * ‖x‖)
GaussianMixturePaper.density_hasDerivAt_time {d : ℕ} {M : ℝ}
  (μ : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsFiniteMeasure μ] (t : ℝ)
  (x : GaussianComparison.GaussianModel.Space d) :
  HasDerivAt (fun s => GaussianComparison.GaussianModel.meanScaledDensity μ s x)
    (∫ (θ : GaussianComparison.GaussianModel.Ball d M),
      (inner ℝ (↑θ) x - t * ‖↑θ‖ ^ 2) * GaussianComparison.GaussianModel.phi (x - t • ↑θ) ∂μ)
    t
GaussianMixturePaper.density_deriv_time_bound {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  {T t : ℝ} (hT : 0 ≤ T) (ht : |t| ≤ T) (x : GaussianComparison.GaussianModel.Space d) :
  |deriv (fun s => GaussianComparison.GaussianModel.meanScaledDensity μ s x) t| ≤
    GaussianMixturePaper.densityTimeEnvelope M T x * GaussianComparison.GaussianModel.meanScaledDensity μ t x
GaussianMixturePaper.density_gradient_space {d : ℕ} {M : ℝ}
  (μ : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsFiniteMeasure μ] (t : ℝ)
  (x : GaussianComparison.GaussianModel.Space d) :
  gradient (GaussianComparison.GaussianModel.meanScaledDensity μ t) x =
    -∫ (θ : GaussianComparison.GaussianModel.Ball d M),
        GaussianComparison.GaussianModel.phi (x - t • ↑θ) • (x - t • ↑θ) ∂μ
GaussianMixturePaper.density_contDiff_one {d : ℕ} {M : ℝ}
  (μ : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsFiniteMeasure μ] :
  ContDiff ℝ 1 fun p => GaussianComparison.GaussianModel.meanScaledDensity μ p.1 p.2
GaussianMixturePaper.lemma6 {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] (α : ℝ) {T t : ℝ} (hT : 0 ≤ T) (ht : |t| ≤ T)
  (x : GaussianComparison.GaussianModel.Space d) :
  |GaussianComparison.GaussianModel.scaledRatio μ ν t x ^ α| +
        ‖gradient (fun y => GaussianComparison.GaussianModel.scaledRatio μ ν t y ^ α) x‖ ≤
      (1 + 2 * |α| * T * M) * Real.exp (|α| * T ^ 2 * M ^ 2 / 2) * Real.exp (2 * |α| * T * M * ‖x‖) ∧
    |GaussianComparison.GaussianModel.scaledLogRatio μ ν t x| +
        ‖gradient (GaussianComparison.GaussianModel.scaledLogRatio μ ν t) x‖ ≤
      (1 + 2 * T * M + T ^ 2 * M ^ 2 / 2) * Real.exp ‖x‖
GaussianMixturePaper.lemma6_gradient {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] (α t : ℝ) (x : GaussianComparison.GaussianModel.Space d) :
  gradient (fun y => GaussianComparison.GaussianModel.scaledRatio μ ν t y ^ α) x =
    (α * t * GaussianComparison.GaussianModel.scaledRatio μ ν t x ^ α) •
      GaussianComparison.GaussianModel.meanScaledGap μ ν t x
GaussianMixturePaper.remark1_gaussian_formulas {M : ℝ} (hM : 0 ≤ M) :
  have p := fun x => GaussianComparison.GaussianModel.phi (x - GaussianMixturePaper.sharpnessMean M);
  have q := fun x => GaussianComparison.GaussianModel.phi (x + GaussianMixturePaper.sharpnessMean M);
  GaussianComparison.kl MeasureTheory.volume p q + GaussianComparison.kl MeasureTheory.volume q p = 4 * M ^ 2 ∧
    max (GaussianComparison.chiSq MeasureTheory.volume p q) (GaussianComparison.chiSq MeasureTheory.volume q p) =
        Real.exp (4 * M ^ 2) - 1 ∧
      GaussianComparison.hellingerSq MeasureTheory.volume p q = 2 * (1 - Real.exp (-M ^ 2 / 2))
GaussianMixturePaper.remark1_hellinger_denominator_pos {M : ℝ} (hM : 0 < M) : 0 < 2 * (1 - Real.exp (-M ^ 2 / 2))
GaussianComparison.GaussianModel.deBruijn_three_generators {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] (s : ℝ) :
  s *
        deriv
          (fun r =>
            GaussianComparison.kl MeasureTheory.volume (GaussianComparison.GaussianModel.meanScaledDensity μ r)
              (GaussianComparison.GaussianModel.meanScaledDensity ν r))
          s =
      GaussianComparison.GaussianModel.generatorFisherTrace μ ν s GaussianComparison.GaussianModel.klGenerator ∧
    s * deriv (GaussianComparison.GaussianModel.meanScalingHellinger μ ν) s =
        GaussianComparison.GaussianModel.generatorFisherTrace μ ν s
          GaussianComparison.GaussianModel.hellingerGenerator ∧
      s * deriv (GaussianComparison.GaussianModel.meanScalingChiSq μ ν) s =
        GaussianComparison.GaussianModel.generatorFisherTrace μ ν s GaussianComparison.GaussianModel.chiSqGenerator
GaussianMixturePaper.mixtureDensity_injective_ae {d : ℕ} {M : ℝ}
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν]
  (he :
    GaussianComparison.GaussianModel.mixtureDensity μ =ᵐ[MeasureTheory.volume]
      GaussianComparison.GaussianModel.mixtureDensity ν) :
  μ = ν
GaussianMixturePaper.hellingerSq_mixture_eq_zero_iff {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] :
  GaussianComparison.hellingerSq MeasureTheory.volume (GaussianComparison.GaussianModel.mixtureDensity μ)
        (GaussianComparison.GaussianModel.mixtureDensity ν) =
      0 ↔
    μ = ν
GaussianMixturePaper.hellingerSq_ambient_eq_zero_iff {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Space d)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] (hμ : ∀ᵐ (θ : GaussianComparison.GaussianModel.Space d) ∂μ, ‖θ‖ ≤ M)
  (hν : ∀ᵐ (θ : GaussianComparison.GaussianModel.Space d) ∂ν, ‖θ‖ ≤ M) :
  GaussianComparison.hellingerSq MeasureTheory.volume (GaussianMixturePaper.ambientMixtureDensity μ)
        (GaussianMixturePaper.ambientMixtureDensity ν) =
      0 ↔
    μ = ν
GaussianMixturePaper.optimal_constant_denominator_pos {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] (hne : μ ≠ ν) :
  0 <
    GaussianComparison.hellingerSq MeasureTheory.volume (GaussianComparison.GaussianModel.mixtureDensity μ)
      (GaussianComparison.GaussianModel.mixtureDensity ν)
GaussianMixturePaper.optimalKL_bounds {M : ℝ} (hM : 0 < M) :
  2 * M ^ 2 / (1 - Real.exp (-M ^ 2 / 2)) ≤ GaussianMixturePaper.optimalKL M ∧
    GaussianMixturePaper.optimalKL M ≤ 2 * M ^ 2 + 4
GaussianMixturePaper.optimalChiSq_bounds {M : ℝ} (hM : 0 < M) :
  (Real.exp (4 * M ^ 2) - 1) / (2 * (1 - Real.exp (-M ^ 2 / 2))) ≤ GaussianMixturePaper.optimalChiSq M ∧
    GaussianMixturePaper.optimalChiSq M ≤ 18 * Real.exp (4 * M ^ 2) - 2
GaussianMixturePaper.optimalKL_asymptotic :
  (fun M => GaussianMixturePaper.optimalKL M - 2 * M ^ 2) =O[Filter.atTop] fun x => 1
GaussianMixturePaper.optimalChiSq_log_asymptotic :
  (fun M => Real.log (GaussianMixturePaper.optimalChiSq M) - 4 * M ^ 2) =O[Filter.atTop] fun x => 1
GaussianMixturePaper.optimalKL_leading_coefficient :
  Filter.Tendsto (fun M => GaussianMixturePaper.optimalKL M / M ^ 2) Filter.atTop (nhds 2)
GaussianMixturePaper.optimalChiSq_leading_exponent :
  Filter.Tendsto (fun M => Real.log (GaussianMixturePaper.optimalChiSq M) / M ^ 2) Filter.atTop (nhds 4)
GaussianMixturePaper.chiSq_comparison_factor36 {M : ℝ} (hM : 0 < M) :
  18 * Real.exp (4 * M ^ 2) - 2 ≤ 36 * GaussianMixturePaper.chiSqExampleRatio M
GaussianMixturePaper.chiSq_bounds_ratio_tendsto36 :
  Filter.Tendsto (fun M => (18 * Real.exp (4 * M ^ 2) - 2) / GaussianMixturePaper.chiSqExampleRatio M) Filter.atTop
    (nhds 36)
GaussianMixturePaper.posteriorJoint_eq_density {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  (t : ℝ) :
  GaussianMixturePaper.posteriorJoint hM μ t =
    (MeasureTheory.volume.prod μ).withDensity fun p =>
      ENNReal.ofReal (GaussianComparison.GaussianModel.phi (p.1 - t • ↑p.2))
GaussianMixturePaper.posteriorKernel_mean {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ] (t : ℝ)
  (x : GaussianComparison.GaussianModel.Space d) :
  ∫ (θ : GaussianComparison.GaussianModel.Ball d M), ↑θ ∂(GaussianMixturePaper.posteriorKernel hM μ t) x =
    GaussianComparison.GaussianModel.meanScaledPosterior μ t x
GaussianMixturePaper.posterior_is_conditionalExpectation {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  (t : ℝ) :
  (GaussianMixturePaper.posteriorJoint hM μ t)[fun p => ↑p.2 |
      MeasurableSpace.comap Prod.fst inferInstance] =ᵐ[GaussianMixturePaper.posteriorJoint hM μ t]
    fun p => GaussianComparison.GaussianModel.meanScaledPosterior μ t p.1
GaussianMixturePaper.independent_observation_joint_density {d : ℕ} {M : ℝ}
  (μ : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  (t : ℝ) :
  MeasureTheory.Measure.map (GaussianMixturePaper.observationPair t) (μ.prod (GaussianMixturePaper.gaussianNoise d)) =
    (MeasureTheory.volume.prod μ).withDensity fun p =>
      ENNReal.ofReal (GaussianComparison.GaussianModel.phi (p.1 - t • ↑p.2))
GaussianMixturePaper.independent_observation_law {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  (t : ℝ) :
  MeasureTheory.Measure.map (fun p => t • ↑p.1 + p.2) (μ.prod (GaussianMixturePaper.gaussianNoise d)) =
    GaussianMixturePaper.observationMeasure μ t
GaussianMixturePaper.priorVector_independent_noise {d : ℕ} {M : ℝ}
  (μ : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ] :
  ProbabilityTheory.IndepFun (fun p => ↑p.1) Prod.snd (μ.prod (GaussianMixturePaper.gaussianNoise d))
GaussianMixturePaper.posterior_is_conditionalExpectation_independent {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  (t : ℝ) :
  (μ.prod (GaussianMixturePaper.gaussianNoise d))[fun p => ↑p.1 |
      MeasurableSpace.comap (fun p => t • ↑p.1 + p.2) inferInstance] =ᵐ[μ.prod (GaussianMixturePaper.gaussianNoise d)]
    fun p => GaussianComparison.GaussianModel.meanScaledPosterior μ t (t • ↑p.1 + p.2)
GaussianMixturePaper.density_PDE {d : ℕ} {M : ℝ} (μ : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M))
  [MeasureTheory.IsFiniteMeasure μ] (t : ℝ) (x : GaussianComparison.GaussianModel.Space d) :
  t * deriv (fun s => GaussianComparison.GaussianModel.meanScaledDensity μ s x) t =
    -GaussianMixturePaper.coordinateDivergence (fun y => GaussianComparison.GaussianModel.meanScaledDensity μ t y • y)
          x -
      GaussianComparison.GaussianModel.coordinateLaplacian (GaussianComparison.GaussianModel.meanScaledDensity μ t) x
GaussianMixturePaper.paperGenerator_boundary_conditions {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] (t : ℝ) (f : ℝ → ℝ) (hf : GaussianMixturePaper.IsPaperGenerator f) :
  Filter.Tendsto
      (fun x =>
        (GaussianComparison.GaussianModel.meanScaledDensity ν t x *
            f
              (GaussianComparison.GaussianModel.meanScaledDensity μ t x /
                GaussianComparison.GaussianModel.meanScaledDensity ν t x)) •
          x)
      (Filter.cocompact (GaussianComparison.GaussianModel.Space d)) (nhds 0) ∧
    Filter.Tendsto
      (fun x =>
        gradient
          (fun y =>
            GaussianComparison.GaussianModel.meanScaledDensity ν t y *
              f
                (GaussianComparison.GaussianModel.meanScaledDensity μ t y /
                  GaussianComparison.GaussianModel.meanScaledDensity ν t y))
          x)
      (Filter.cocompact (GaussianComparison.GaussianModel.Space d)) (nhds 0)
GaussianMixturePaper.hellinger_interpolation_range {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] (t : ℝ) :
  GaussianComparison.GaussianModel.meanScalingHellinger μ ν t ∈ Set.Icc 0 2
GaussianMixturePaper.hellinger_interpolation_monotone {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] :
  MonotoneOn (GaussianComparison.GaussianModel.meanScalingHellinger μ ν) (Set.Ici 0)
GaussianMixturePaper.appendix_envelopes_integrable {d : ℕ} (M T : ℝ) :
  MeasureTheory.Integrable (GaussianMixturePaper.PJ M T) MeasureTheory.volume ∧
    MeasureTheory.Integrable (GaussianMixturePaper.QJ M T) MeasureTheory.volume ∧
      MeasureTheory.Integrable (GaussianMixturePaper.PC M T) MeasureTheory.volume ∧
        MeasureTheory.Integrable (GaussianMixturePaper.QC M T) MeasureTheory.volume ∧
          MeasureTheory.Integrable (GaussianMixturePaper.PA M T) MeasureTheory.volume ∧
            MeasureTheory.Integrable (GaussianMixturePaper.QA M T) MeasureTheory.volume
GaussianMixturePaper.appendix_raw_domination {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] {T t : ℝ} (hT : 0 ≤ T) (ht : |t| ≤ T)
  (x : GaussianComparison.GaussianModel.Space d) :
  |GaussianMixturePaper.rawKL μ ν t x| ≤ GaussianMixturePaper.PJ M T x ∧
    |deriv (fun s => GaussianMixturePaper.rawKL μ ν s x) t| ≤ GaussianMixturePaper.QJ M T x ∧
      |GaussianMixturePaper.rawChi μ ν t x| ≤ GaussianMixturePaper.PC M T x ∧
        |deriv (fun s => GaussianMixturePaper.rawChi μ ν s x) t| ≤ GaussianMixturePaper.QC M T x ∧
          |GaussianMixturePaper.rawAffinity μ ν t x| ≤ GaussianMixturePaper.PA M T x ∧
            |deriv (fun s => GaussianMixturePaper.rawAffinity μ ν s x) t| ≤ GaussianMixturePaper.QA M T x
GaussianMixturePaper.integral_density_deriv_zero {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  (t : ℝ) :
  MeasureTheory.Integrable (fun x => deriv (fun s => GaussianComparison.GaussianModel.meanScaledDensity μ s x) t)
      MeasureTheory.volume ∧
    ∫ (x : GaussianComparison.GaussianModel.Space d),
        deriv (fun s => GaussianComparison.GaussianModel.meanScaledDensity μ s x) t =
      0
GaussianMixturePaper.gaussian_component_bound {d : ℕ} {M : ℝ} (hM : 0 ≤ M) {T t : ℝ} (hT : 0 ≤ T) (ht : |t| ≤ T)
  (θ : GaussianComparison.GaussianModel.Ball d M) (x : GaussianComparison.GaussianModel.Space d) :
  GaussianComparison.GaussianModel.phi (x - t • ↑θ) ≤ GaussianComparison.GaussianModel.phi x * Real.exp (T * M * ‖x‖)
GaussianMixturePaper.gaussian_component_deriv_bound {d : ℕ} {M : ℝ} (hM : 0 ≤ M) {T t : ℝ} (hT : 0 ≤ T) (ht : |t| ≤ T)
  (θ : GaussianComparison.GaussianModel.Ball d M) (x : GaussianComparison.GaussianModel.Space d) :
  |deriv (fun s => GaussianComparison.GaussianModel.phi (x - s • ↑θ)) t| ≤
    (M * ‖x‖ + T * M ^ 2) * GaussianComparison.GaussianModel.phi x * Real.exp (T * M * ‖x‖)
GaussianMixturePaper.integral_PC_add_QC_bound {d : ℕ} {M : ℝ} (hM : 0 ≤ M) {T : ℝ} (hT : 0 ≤ T) :
  ∫ (x : GaussianComparison.GaussianModel.Space d), GaussianMixturePaper.PC M T x + GaussianMixturePaper.QC M T x ≤
    Real.exp (T ^ 2 * M ^ 2 / 2) * GaussianMixturePaper.appendixS (3 * T * M) d +
        4 * T * M ^ 2 * Real.exp (T ^ 2 * M ^ 2) * GaussianMixturePaper.appendixS (5 * T * M) d +
      4 * M * Real.exp (T ^ 2 * M ^ 2) * GaussianMixturePaper.appendixK (5 * T * M) d 1
GaussianMixturePaper.integral_PA_add_QA_bound {d : ℕ} {M : ℝ} (hM : 0 ≤ M) {T : ℝ} (hT : 0 ≤ T) :
  ∫ (x : GaussianComparison.GaussianModel.Space d), GaussianMixturePaper.PA M T x + GaussianMixturePaper.QA M T x ≤
    GaussianMixturePaper.appendixS (T * M) d +
        T * M ^ 2 * Real.exp (T ^ 2 * M ^ 2 / 4) * GaussianMixturePaper.appendixS (2 * T * M) d +
      M * Real.exp (T ^ 2 * M ^ 2 / 4) * GaussianMixturePaper.appendixK (2 * T * M) d 1
GaussianMixturePaper.chiSq_explicit_finiteness_bound {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] {T t : ℝ} (hT : 0 ≤ T) (ht : |t| ≤ T) :
  0 ≤ GaussianComparison.GaussianModel.meanScalingChiSq μ ν t ∧
    GaussianComparison.GaussianModel.meanScalingChiSq μ ν t ≤
      Real.exp (T ^ 2 * M ^ 2 / 2) * GaussianMixturePaper.appendixS (3 * T * M) d - 1
GaussianComparison.GaussianModel.densityFDivergence_kl.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  {m : MeasureTheory.Measure Ω} {p q : Ω → ℝ} (hf : GaussianComparison.FiniteDivergences m p q) :
  GaussianComparison.GaussianModel.densityFDivergence m p q GaussianComparison.GaussianModel.klGenerator =
    GaussianComparison.kl m p q
GaussianComparison.GaussianModel.densityFDivergence_hellinger.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  {m : MeasureTheory.Measure Ω} {p q : Ω → ℝ} (hf : GaussianComparison.FiniteDivergences m p q) :
  GaussianComparison.GaussianModel.densityFDivergence m p q GaussianComparison.GaussianModel.hellingerGenerator =
    GaussianComparison.hellingerSq m p q
GaussianComparison.GaussianModel.densityFDivergence_chiSq.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  (m : MeasureTheory.Measure Ω) (p q : Ω → ℝ) :
  GaussianComparison.GaussianModel.densityFDivergence m p q GaussianComparison.GaussianModel.chiSqGenerator =
    GaussianComparison.chiSq m p q
GaussianComparison.GaussianModel.integrable_generatorFisherMatrix_entry {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] (s : ℝ) (f : ℝ → ℝ) (hf : GaussianComparison.GaussianModel.IsPaperGenerator f)
  (i j : Fin d) :
  MeasureTheory.Integrable
    (fun x =>
      GaussianComparison.GaussianModel.generatorDensityWeight μ ν s f x *
          (GaussianComparison.GaussianModel.likelihoodScore μ ν s x).ofLp i *
        (GaussianComparison.GaussianModel.likelihoodScore μ ν s x).ofLp j)
    MeasureTheory.volume
GaussianComparison.GaussianModel.generatorFisherMatrix_trace {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] (s : ℝ) (f : ℝ → ℝ)
  (hf : GaussianComparison.GaussianModel.IsPaperGenerator f) :
  (GaussianComparison.GaussianModel.generatorFisherMatrix μ ν s f).trace =
    GaussianComparison.GaussianModel.generatorFisherTrace μ ν s f
GaussianComparison.GaussianModel.deBruijn_matrix {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] (s : ℝ) (f : ℝ → ℝ)
  (hf : GaussianComparison.GaussianModel.IsPaperGenerator f) :
  s *
      deriv
        (fun r =>
          GaussianComparison.GaussianModel.densityFDivergence MeasureTheory.volume
            (GaussianComparison.GaussianModel.meanScaledDensity μ r)
            (GaussianComparison.GaussianModel.meanScaledDensity ν r) f)
        s =
    (GaussianComparison.GaussianModel.generatorFisherMatrix μ ν s f).trace
GaussianMixturePaper.PaperCutoff.contDiff_chi {d : ℕ} {R : ℝ} (hR : 0 < R) :
  ContDiff ℝ 1 (GaussianMixturePaper.PaperCutoff.chi R)
GaussianMixturePaper.PaperCutoff.chi_hasCompactSupport {d : ℕ} {R : ℝ} (hR : 0 < R) :
  HasCompactSupport (GaussianMixturePaper.PaperCutoff.chi R)
GaussianMixturePaper.PaperCutoff.gradient_chi_bound {d : ℕ} {R : ℝ} (hR : 0 < R)
  (x : GaussianComparison.GaussianModel.Space d) : ‖gradient (GaussianMixturePaper.PaperCutoff.chi R) x‖ ≤ 3 / (2 * R)
GaussianMixturePaper.PaperCutoff.tendsto_integral_mul_chi {d : ℕ}
  {μ : MeasureTheory.Measure (GaussianComparison.GaussianModel.Space d)}
  {A : GaussianComparison.GaussianModel.Space d → ℝ} (hA : MeasureTheory.Integrable A μ) :
  Filter.Tendsto
    (fun R => ∫ (x : GaussianComparison.GaussianModel.Space d), A x * GaussianMixturePaper.PaperCutoff.chi R x ∂μ)
    Filter.atTop (nhds (∫ (x : GaussianComparison.GaussianModel.Space d), A x ∂μ))
GaussianMixturePaper.PaperCutoff.tendsto_boundaryTerm {d : ℕ}
  {μ : MeasureTheory.Measure (GaussianComparison.GaussianModel.Space d)}
  {A : GaussianComparison.GaussianModel.Space d → ℝ} (hA : MeasureTheory.Integrable A μ)
  (θ : GaussianComparison.GaussianModel.Space d) :
  Filter.Tendsto (GaussianMixturePaper.PaperCutoff.boundaryTerm μ A θ) Filter.atTop (nhds 0)
GaussianMixturePaper.PaperCutoff.gaussian_boundaryTerm_bound {d : ℕ} {M T t L c R : ℝ} (hM : 0 ≤ M) (ht : |t| ≤ T)
  (θ : GaussianComparison.GaussianModel.Ball d M) {g : GaussianComparison.GaussianModel.Space d → ℝ} (hg : Continuous g)
  (hL : 0 ≤ L) (hbound : ∀ (x : GaussianComparison.GaussianModel.Space d), |g x| ≤ L * Real.exp (c * ‖x‖))
  (hR : 0 < R) :
  |GaussianMixturePaper.PaperCutoff.boundaryTerm MeasureTheory.volume
        (fun x => GaussianComparison.GaussianModel.phi (x - t • ↑θ) * g x) (↑θ) R| ≤
    3 * M * L * (2 ^ (↑d / 2) * Real.exp ((c + T * M) ^ 2)) / (2 * R)
GaussianMixturePaper.PaperCutoff.gaussian_integration_by_parts_via_cutoff {d : ℕ} {M L c : ℝ} (hM : 0 ≤ M)
  (θ : GaussianComparison.GaussianModel.Ball d M) {g : GaussianComparison.GaussianModel.Space d → ℝ}
  (hg : ContDiff ℝ 1 g) (hL : 0 ≤ L) (hc : 0 ≤ c)
  (hbound : ∀ (x : GaussianComparison.GaussianModel.Space d), |g x| + ‖gradient g x‖ ≤ L * Real.exp (c * ‖x‖)) (t : ℝ) :
  ∫ (x : GaussianComparison.GaussianModel.Space d),
      (inner ℝ (↑θ) x - t * ‖↑θ‖ ^ 2) * GaussianComparison.GaussianModel.phi (x - t • ↑θ) * g x =
    ∫ (x : GaussianComparison.GaussianModel.Space d),
      GaussianComparison.GaussianModel.phi (x - t • ↑θ) * inner ℝ (↑θ) (gradient g x)
GaussianMixturePaper.PaperCutoff.lemma2_via_cutoff {d : ℕ} {M L c : ℝ} (hM : 0 ≤ M)
  (μ : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  {g : GaussianComparison.GaussianModel.Space d → ℝ} (hg : ContDiff ℝ 1 g) (hL : 0 ≤ L) (hc : 0 ≤ c)
  (hbound : ∀ (x : GaussianComparison.GaussianModel.Space d), |g x| + ‖gradient g x‖ ≤ L * Real.exp (c * ‖x‖)) (t : ℝ) :
  MeasureTheory.Integrable (fun x => deriv (fun s => GaussianComparison.GaussianModel.meanScaledDensity μ s x) t * g x)
      MeasureTheory.volume ∧
    MeasureTheory.Integrable
        (fun x =>
          GaussianComparison.GaussianModel.meanScaledDensity μ t x *
            inner ℝ (gradient g x) (GaussianComparison.GaussianModel.meanScaledPosterior μ t x))
        MeasureTheory.volume ∧
      ∫ (x : GaussianComparison.GaussianModel.Space d),
          deriv (fun s => GaussianComparison.GaussianModel.meanScaledDensity μ s x) t * g x =
        ∫ (x : GaussianComparison.GaussianModel.Space d),
          GaussianComparison.GaussianModel.meanScaledDensity μ t x *
            inner ℝ (gradient g x) (GaussianComparison.GaussianModel.meanScaledPosterior μ t x)
GaussianComparison.GaussianModel.generalFDivergence_hasDerivAt {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] {f : ℝ → ℝ} (hf : GaussianComparison.GaussianModel.PositiveC2Generator f)
  (hg : GaussianComparison.GaussianModel.LocalGeneratorGrowth μ ν f) (s : ℝ) :
  HasDerivAt
    (fun r =>
      GaussianComparison.GaussianModel.densityFDivergence MeasureTheory.volume
        (GaussianComparison.GaussianModel.meanScaledDensity μ r)
        (GaussianComparison.GaussianModel.meanScaledDensity ν r) f)
    (s *
      ∫ (x : GaussianComparison.GaussianModel.Space d),
        GaussianComparison.GaussianModel.meanScaledDensity ν s x *
              GaussianComparison.GaussianModel.scaledRatio μ ν s x ^ 2 *
            deriv (deriv f) (GaussianComparison.GaussianModel.scaledRatio μ ν s x) *
          ‖GaussianComparison.GaussianModel.meanScaledGap μ ν s x‖ ^ 2)
    s
GaussianComparison.GaussianModel.general_deBruijn_matrix {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] {f : ℝ → ℝ} (hf : GaussianComparison.GaussianModel.PositiveC2Generator f)
  (hg : GaussianComparison.GaussianModel.LocalGeneratorGrowth μ ν f) (s : ℝ) :
  s *
      deriv
        (fun r =>
          GaussianComparison.GaussianModel.densityFDivergence MeasureTheory.volume
            (GaussianComparison.GaussianModel.meanScaledDensity μ r)
            (GaussianComparison.GaussianModel.meanScaledDensity ν r) f)
        s =
    (GaussianComparison.GaussianModel.generatorFisherMatrix μ ν s f).trace
GaussianComparison.GaussianModel.paperGenerator_convex (f : ℝ → ℝ) (hf : GaussianMixturePaper.IsPaperGenerator f) :
  ConvexOn ℝ (Set.Ici 0) f
GaussianComparison.GaussianModel.paperGenerator_admissible {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] (f : ℝ → ℝ) (hf : GaussianMixturePaper.IsPaperGenerator f) :
  GaussianComparison.GaussianModel.PositiveC2Generator f ∧ GaussianComparison.GaussianModel.LocalGeneratorGrowth μ ν f
GaussianComparison.GaussianModel.paperGenerator_general_deBruijn {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] (f : ℝ → ℝ) (hf : GaussianMixturePaper.IsPaperGenerator f) (s : ℝ) :
  s *
      deriv
        (fun r =>
          GaussianComparison.GaussianModel.densityFDivergence MeasureTheory.volume
            (GaussianComparison.GaussianModel.meanScaledDensity μ r)
            (GaussianComparison.GaussianModel.meanScaledDensity ν r) f)
        s =
    (GaussianComparison.GaussianModel.generatorFisherMatrix μ ν s f).trace
GaussianComparison.GaussianModel.paperGeneratorDensity_time_derivatives_integrable {d : ℕ} {M : ℝ}
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] (hM : 0 ≤ M) (f : ℝ → ℝ)
  (hf : GaussianComparison.GaussianModel.IsPaperGenerator f) (t : ℝ) :
  MeasureTheory.Integrable
      (fun x => deriv (fun s => GaussianComparison.GaussianModel.paperGeneratorDensity μ ν f s x) t)
      MeasureTheory.volume ∧
    MeasureTheory.Integrable
      (fun x => deriv (deriv fun s => GaussianComparison.GaussianModel.paperGeneratorDensity μ ν f s x) t)
      MeasureTheory.volume
GaussianComparison.GaussianModel.paperGeneratorDensity_time_derivatives_local_envelope {d : ℕ} {M : ℝ}
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] (hM : 0 ≤ M) (f : ℝ → ℝ)
  (hf : GaussianComparison.GaussianModel.IsPaperGenerator f) {T : ℝ} (hT : 0 ≤ T) :
  ∃ C c,
    0 ≤ C ∧
      0 ≤ c ∧
        MeasureTheory.Integrable (fun x => C * (GaussianComparison.GaussianModel.phi x * Real.exp (c * ‖x‖)))
            MeasureTheory.volume ∧
          ∀ (t : ℝ),
            |t| ≤ T →
              ∀ (x : GaussianComparison.GaussianModel.Space d),
                |deriv (fun s => GaussianComparison.GaussianModel.paperGeneratorDensity μ ν f s x) t| +
                    |deriv (deriv fun s => GaussianComparison.GaussianModel.paperGeneratorDensity μ ν f s x) t| ≤
                  C * (GaussianComparison.GaussianModel.phi x * Real.exp (c * ‖x‖))
GaussianComparison.GaussianModel.integrable_generalFDivergence {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] {f : ℝ → ℝ} (hf : GaussianComparison.GaussianModel.PositiveC2Generator f)
  (hg : GaussianComparison.GaussianModel.LocalGeneratorGrowth μ ν f) (s : ℝ) :
  MeasureTheory.Integrable
    (fun x =>
      GaussianComparison.GaussianModel.meanScaledDensity ν s x *
        f
          (GaussianComparison.GaussianModel.meanScaledDensity μ s x /
            GaussianComparison.GaussianModel.meanScaledDensity ν s x))
    MeasureTheory.volume
GaussianComparison.GaussianModel.generalFDivergence_contDiff_one {d : ℕ} {M : ℝ} (hM : 0 ≤ M)
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] {f : ℝ → ℝ} (hf : GaussianComparison.GaussianModel.PositiveC2Generator f)
  (hg : GaussianComparison.GaussianModel.LocalGeneratorGrowth μ ν f) :
  ContDiff ℝ 1 fun r =>
    GaussianComparison.GaussianModel.densityFDivergence MeasureTheory.volume
      (GaussianComparison.GaussianModel.meanScaledDensity μ r) (GaussianComparison.GaussianModel.meanScaledDensity ν r)
      f
GaussianComparison.GaussianModel.paperGeneratorDensity_contDiff_two {d : ℕ} {M : ℝ}
  (μ ν : MeasureTheory.Measure (GaussianComparison.GaussianModel.Ball d M)) [MeasureTheory.IsProbabilityMeasure μ]
  [MeasureTheory.IsProbabilityMeasure ν] (hM : 0 ≤ M) (f : ℝ → ℝ)
  (hf : GaussianComparison.GaussianModel.IsPaperGenerator f) (x : GaussianComparison.GaussianModel.Space d) :
  ContDiff ℝ 2 fun t => GaussianComparison.GaussianModel.paperGeneratorDensity μ ν f t x
